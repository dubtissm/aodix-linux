@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .

<urn:aodix:adxtest-lv2>
	a lv2:Plugin ;
	lv2:binary <adxtest_lv2.so> ;
	rdfs:seeAlso <adxtest.ttl> .

<urn:aodix:adxtest-lv2#ui>
	a ui:X11UI ;
	ui:binary <adxtest_lv2_ui.so> ;
	rdfs:seeAlso <adxtest.ttl> .
