@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix pprop: <http://lv2plug.in/ns/ext/port-props#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix time:  <http://lv2plug.in/ns/ext/time#> .
@prefix ui:    <http://lv2plug.in/ns/extensions/ui#> .
@prefix urid:  <http://lv2plug.in/ns/ext/urid#> .
@prefix work:  <http://lv2plug.in/ns/ext/worker#> .
@prefix opts:  <http://lv2plug.in/ns/ext/options#> .

<urn:aodix:adxtest-lv2>
	a lv2:InstrumentPlugin , lv2:Plugin ;
	doap:name "ADX Test LV2 Synth" ;
	lv2:requiredFeature urid:map , work:schedule ;
	lv2:optionalFeature lv2:hardRTCapable , opts:options ;
	lv2:extensionData work:interface , state:interface ;
	ui:ui <urn:aodix:adxtest-lv2#ui> ;
	lv2:port [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 0 ; lv2:symbol "gain" ; lv2:name "Gain" ;
		lv2:default 0.8 ; lv2:minimum 0.0 ; lv2:maximum 1.0
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 1 ; lv2:symbol "cutoff" ; lv2:name "Cutoff" ;
		lv2:portProperty pprop:logarithmic ;
		lv2:default 2000.0 ; lv2:minimum 20.0 ; lv2:maximum 20000.0
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 2 ; lv2:symbol "mute" ; lv2:name "Mute" ;
		lv2:portProperty lv2:toggled ;
		lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 3 ; lv2:symbol "wave" ; lv2:name "Wave" ;
		lv2:portProperty lv2:integer ;
		lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 3
	] , [
		a lv2:OutputPort , lv2:ControlPort ;
		lv2:index 4 ; lv2:symbol "level" ; lv2:name "Level" ;
		lv2:minimum 0.0 ; lv2:maximum 1.0
	] , [
		a lv2:InputPort , atom:AtomPort ;
		atom:bufferType atom:Sequence ;
		atom:supports midi:MidiEvent , time:Position ;
		lv2:designation lv2:control ;
		lv2:index 5 ; lv2:symbol "events" ; lv2:name "Events"
	] , [
		a lv2:OutputPort , atom:AtomPort ;
		atom:bufferType atom:Sequence ;
		atom:supports midi:MidiEvent ;
		lv2:index 6 ; lv2:symbol "notify" ; lv2:name "Notify"
	] , [
		a lv2:OutputPort , lv2:AudioPort ;
		lv2:index 7 ; lv2:symbol "out_l" ; lv2:name "Out L"
	] , [
		a lv2:OutputPort , lv2:AudioPort ;
		lv2:index 8 ; lv2:symbol "out_r" ; lv2:name "Out R"
	] .

<urn:aodix:adxtest-lv2#ui>
	a ui:X11UI ;
	lv2:optionalFeature ui:resize , ui:parent ;
	lv2:extensionData ui:idleInterface , ui:resize ;
	ui:portNotification [ ui:plugin <urn:aodix:adxtest-lv2> ; lv2:symbol "level" ; ui:protocol ui:floatProtocol ] .
